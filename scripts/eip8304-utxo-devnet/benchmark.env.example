# Copy to benchmark.env and use disposable devnet-only keys.
# benchmark.env and results/ are ignored by Git.
UTXO_RPC=http://127.0.0.1:8545
UTXO_PYTHON=/mnt/d/bogota/ethrex/scripts/hegota-devnet/.venv/bin/python

FUNDED_1_ADDRESS=0x2353E650094Cdae828Ed2A3bc2503dE9123bE5E1
FUNDED_1_PRIVATE_KEY=0x_REPLACE_WITH_FUNDED_PRIVATE_KEY_1
FUNDED_2_ADDRESS=0x8B54b45663B4aF65d51D7F98C20f533965E0a013
FUNDED_2_PRIVATE_KEY=0x_REPLACE_WITH_FUNDED_PRIVATE_KEY_2

# Deposits are sent randomly to inspector 1 or 2. Those wallets then spend a
# random portion to inspector 3 or 4.
INSPECT_1_ADDRESS=0x_REPLACE_WITH_INSPECT_ADDRESS_1
INSPECT_1_PRIVATE_KEY=0x_REPLACE_WITH_INSPECT_PRIVATE_KEY_1
INSPECT_2_ADDRESS=0x_REPLACE_WITH_INSPECT_ADDRESS_2
INSPECT_2_PRIVATE_KEY=0x_REPLACE_WITH_INSPECT_PRIVATE_KEY_2
INSPECT_3_ADDRESS=0x_REPLACE_WITH_INSPECT_ADDRESS_3
INSPECT_3_PRIVATE_KEY=0x_REPLACE_WITH_INSPECT_PRIVATE_KEY_3
INSPECT_4_ADDRESS=0x_REPLACE_WITH_INSPECT_ADDRESS_4
INSPECT_4_PRIVATE_KEY=0x_REPLACE_WITH_INSPECT_PRIVATE_KEY_4

BENCHMARK_CASES=5
BENCHMARK_SEED=8304
# Discovery measurements use one cold run, then discard these warmups and
# report median/p95 over the measured repetitions. Table queries, root reads,
# and matching receipt requests use this bounded concurrency.
DISCOVERY_WARMUPS=2
DISCOVERY_REPETITIONS=7
UTXO_DISCOVERY_CONCURRENCY=8
# Each fan-out transaction creates this many positive-value UTXOs for the
# destination inspector, plus one change UTXO. Values below 100 are rejected.
UTXOS_PER_BLOCK=100
MIN_DELAY_MS=1000
MAX_DELAY_MS=4000
MIN_DEPOSIT_ETH=0.020
MAX_DEPOSIT_ETH=0.030
BLOCK_TIMEOUT_MS=180000
REQUIRE_ZERO_INSPECTOR_BALANCE=1

# Sparse-history benchmark. Five single-UTXO transfers are placed 25-30 blocks
# apart and every wallet scans the same aligned 144-block history.
SPARSE_EVENTS=5
SPARSE_MIN_GAP_BLOCKS=25
SPARSE_MAX_GAP_BLOCKS=30
SPARSE_SCAN_BLOCKS=144
SPARSE_TABLE_SETTLEMENT_BLOCKS=16
SPARSE_SEED_ETH=0.050
SPARSE_WAIT_TIMEOUT_MS=900000
# Long-range preset example (about 55-60 minutes at three-second slots):
# SPARSE_EVENTS=2
# SPARSE_MIN_GAP_BLOCKS=100
# SPARSE_MAX_GAP_BLOCKS=1000
# SPARSE_SCAN_BLOCKS=1024
# SPARSE_TABLE_SETTLEMENT_BLOCKS=64

# Mixed-address continuous workload and fixed-window item lookup.
MIXED_MIN_UTXOS=70
MIXED_MAX_UTXOS=100
MIXED_FIRST_WINDOW_BLOCKS=100
MIXED_SECOND_WINDOW_BLOCKS=150
MIXED_CARRIER_ETH=1.0
MIXED_OUTPUT_VALUE_WEI=1000000000000
MIXED_WAIT_TIMEOUT_MS=600000
# Require this many canonical child blocks before accepting a receipt. Reorged
# transactions are automatically resubmitted with the same signed bytes.
MIXED_CONFIRMATIONS=3
