# Copy this file to wallets.env and replace every placeholder with disposable
# devnet-only wallet details. Never use production or testnet private keys.
RPC=http://127.0.0.1:32003
INTERVAL_BLOCKS=30
UTXO_VALUE_WEI=10000000000000000

# Four funded wallets. The script uses only FUNDED_1 for emission.
FUNDED_1_ADDRESS=replace_with_funded_1_address
FUNDED_1_PRIVATE_KEY=replace_with_disposable_devnet_private_key
FUNDED_2_ADDRESS=replace_with_funded_2_address
FUNDED_2_PRIVATE_KEY=replace_with_disposable_devnet_private_key
FUNDED_3_ADDRESS=replace_with_funded_3_address
FUNDED_3_PRIVATE_KEY=replace_with_disposable_devnet_private_key
FUNDED_4_ADDRESS=replace_with_funded_4_address
FUNDED_4_PRIVATE_KEY=replace_with_disposable_devnet_private_key

# Four recipient/inspector wallets. They should start with zero ETH.
INSPECT_1_ADDRESS=replace_with_inspect_1_address
INSPECT_1_PRIVATE_KEY=replace_with_disposable_devnet_private_key
INSPECT_2_ADDRESS=replace_with_inspect_2_address
INSPECT_2_PRIVATE_KEY=replace_with_disposable_devnet_private_key
INSPECT_3_ADDRESS=replace_with_inspect_3_address
INSPECT_3_PRIVATE_KEY=replace_with_disposable_devnet_private_key
INSPECT_4_ADDRESS=replace_with_inspect_4_address
INSPECT_4_PRIVATE_KEY=replace_with_disposable_devnet_private_key
